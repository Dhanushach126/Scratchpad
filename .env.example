# Supabase Credentials (Required for Auth, Database & Permissions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare R2 (Required for 500MB per file uploads & 0 egress fees)
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=scratchpad-files
# Optional: R2.dev public URL or Custom Domain for faster CDN delivery
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
